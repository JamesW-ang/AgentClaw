# ============================================================================
# AgentClaw AI Agent - 环境变量配置
# ============================================================================
# 复制本文件为 .env 并填入实际值：cp .env.example .env
# ============================================================================

# ---------- LLM API 配置（必填，至少填一个）----------
# DeepSeek（推荐，便宜好用）
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# OpenAI（备选）
OPENAI_API_KEY=sk-your-openai-key-here

# 智谱（备选）
ZHIPU_API_KEY=your-zhipu-key-here

# ---------- 默认模型 ----------
DEFAULT_MODEL=deepseek-chat
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small

# ---------- Agent 配置 ----------
AGENT_MODE=single
MAX_TOOLS_CALLS=10
MAX_ITERATIONS=30

# ---------- FastAPI ----------
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# ---------- Gradio ----------
GRADIO_HOST=0.0.0.0
GRADIO_PORT=7860

# ---------- ChromaDB（Docker 内部通信）----------
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# ---------- 日志级别 ----------
LOG_LEVEL=INFO
