# ============================================================================
# AgentClaw AI Agent - 环境变量配置
# ============================================================================
# 复制本文件为 .env 并填入实际值：cp .env.example .env
# ============================================================================

# ---------- LLM API 配置（必填）----------
# DeepSeek（推荐，便宜好用）
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---------- 智谱 Zhipu API 配置（多模态必填）----------
# 用于 GLM-4V 视觉理解和 CogView 文生图
ZHIPU_API_KEY=your-zhipu-key-here
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ---------- OpenAI API 配置（可选）----------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ---------- 默认模型 ----------
LLM_MODEL=deepseek-chat
VISION_MODEL=glm-4v-flash

# ---------- SerpAPI 配置（可选，用于 web_search 三级降级）----------
SERPAPI_KEY=

# ---------- 服务端口 ----------
API_PORT=8000
WEB_PORT=7860

# ---------- ChromaDB ----------
CHROMA_DB_PATH=./data/chroma_db

# ---------- 日志 ----------
LOG_LEVEL=INFO
LOG_DIR=./data/logs

# ---------- 工具执行 ----------
TOOL_TIMEOUT=30
REACT_MAX_ROUNDS=5
